      "name": "01. Users",
      "item": [
        {
          "name": "01 | GET | Список пользователей и сохранение переменных",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Ответ — непустой массив\", () => {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "pm.test(\"ID пользователей уникальны\", () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(new Set(data.map(x => x.id)).size).to.equal(data.length);",
                  "});",
                  "",
                  "pm.test(\"Сохранены userId и username первого пользователя\", () => {",
                  "    const first = pm.response.json()[0];",
                  "    pm.expect(first.id).to.be.a(\"number\");",
                  "    pm.expect(first.username).to.be.a(\"string\").and.not.empty;",
                  "    pm.collectionVariables.set(\"userId\", String(first.id));",
                  "    pm.collectionVariables.set(\"username\", first.username);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "**TC-01. Список пользователей и сохранение переменных**\n\nЦель: Проверить список, уникальность ID и передачу данных следующим запросам.\n\nОжидаемый HTTP-статус: **200**. Остальные ожидаемые результаты указаны в именах автотестов (Scripts → Post-response).\n\nЗапрос можно запускать отдельно с исходными переменными коллекции."
          },
          "response": []
        },
        {
          "name": "02 | GET | Пользователь по ID и JSON Schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"ID совпадает с запрошенным\", () => {",
                  "    pm.expect(pm.response.json().id).to.equal(Number(pm.variables.get(\"userId\")));",
                  "});",
                  "",
                  "pm.test(\"Ответ соответствует JSON Schema\", () => {",
                  "    pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"id\", \"name\", \"username\", \"email\", \"address\", \"phone\", \"website\", \"company\"], \"properties\": {\"id\": {\"type\": \"integer\", \"minimum\": 1}, \"name\": {\"type\": \"string\", \"minLength\": 1}, \"username\": {\"type\": \"string\", \"minLength\": 1}, \"email\": {\"type\": \"string\", \"minLength\": 1}, \"phone\": {\"type\": \"string\", \"minLength\": 1}, \"website\": {\"type\": \"string\", \"minLength\": 1}, \"address\": {\"type\": \"object\", \"required\": [\"street\", \"city\", \"zipcode\", \"geo\"], \"properties\": {\"geo\": {\"type\": \"object\", \"required\": [\"lat\", \"lng\"], \"properties\": {\"lat\": {\"type\": \"string\"}, \"lng\": {\"type\": \"string\"}}}}}, \"company\": {\"type\": \"object\", \"required\": [\"name\"]}}});",
                  "});",
                  "",
                  "pm.test(\"Email имеет базовую корректную структуру\", () => {",
                  "    pm.expect(pm.response.json().email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);",
                  "});"
                ]
              }
            }
          ],
