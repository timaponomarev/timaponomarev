        {
          "name": "09 | POST | Создание публикации",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Динамическое значение уникально для каждого запуска.",
                  "pm.variables.set(\"newTitle\", \"QA portfolio \" + pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Ответ соответствует JSON Schema\", () => {",
                  "    pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"userId\", \"id\", \"title\", \"body\"], \"properties\": {\"userId\": {\"type\": \"integer\", \"minimum\": 1}, \"id\": {\"type\": \"integer\", \"minimum\": 1}, \"title\": {\"type\": \"string\", \"minLength\": 1}, \"body\": {\"type\": \"string\", \"minLength\": 1}}});",
                  "});",
                  "",
                  "pm.test(\"Сервер вернул отправленные данные\", () => {",
                  "    const sent = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "    const actual = pm.response.json();",
                  "    [\"title\", \"body\", \"userId\"].forEach(key => pm.expect(actual[key]).to.deep.equal(sent[key]));",
                  "});",
                  "",
                  "pm.test(\"Созданному ресурсу назначен ID\", () => {",
                  "    pm.expect(pm.response.json().id).to.be.a(\"number\").and.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{newTitle}}\",\n  \"body\": \"Portfolio API test body\",\n  \"userId\": 1\n}",
              "options": {
